{
  "name": "qiankun-vue3",
  "version": "1.0.1",
  "description": "基于qiankun+vue3.0技术栈实现的前端微应用架构。",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./main\" --filter \"./sub-*\" run serve",
    "dev:main": "pnpm --filter main run serve",
    "dev:sub-vue": "pnpm --filter sub-vue run serve",
    "dev:sub-react": "pnpm --filter sub-react run serve",
    "dev:sub-html": "pnpm --filter sub-html run serve",
    "build": "pnpm build:packages && pnpm --recursive --filter \"./main\" --filter \"./sub-*\" run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:main": "pnpm --filter main run build",
    "build:sub-vue": "pnpm --filter sub-vue run build",
    "build:sub-react": "pnpm --filter sub-react run build",
    "build:sub-html": "pnpm --filter sub-html run build",
    "clean": "pnpm --recursive exec rm -rf node_modules dist",
    "clean:packages": "pnpm --filter \"./packages/*\" run clean",
    "lint": "pnpm --recursive run lint",
    "type-check": "pnpm --recursive run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "commit": "cz"
  },
  "keywords": [
    "qiankun",
    "micro-frontend",
    "vue3",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "commitizen": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,json,css,scss,md}": "prettier --write"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
